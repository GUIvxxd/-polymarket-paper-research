# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.asc
*.gpg
*.age
.netrc
.npmrc
.pypirc
**/.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*credentials*.json
*secrets*.json
*secret*.yaml
*secret*.yml
*wallet*.json
*keystore*.json
