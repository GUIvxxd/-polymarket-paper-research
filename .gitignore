# Editor, OS and temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/

# Deterministic fixtures are source artifacts even when their extensions match
# generated data. These rules intentionally come last.
!tests/fixtures/
!tests/fixtures/**
!testdata/
!testdata/**
!fixtures/
!fixtures/**
