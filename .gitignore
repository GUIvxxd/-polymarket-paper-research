*seed_phrase*.txt
*cookies*.txt
*.cookie

# Mutable production/runtime state. Keep these paths where the scheduler expects
# them, but back them up outside Git.
/data/**
/reports/**
/logs/**
/REPORT.md

# A separate nested prototype/repository and its virtual environment. Do not
# embed its .git directory in this parent repository.
/repos/**

# Python environments, bytecode and tool caches
.venv/
venv/
env/
virtualenv/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node artifacts (the active project is Python-only, but prevent accidental
# vendoring if Node tooling is used for documentation later).
node_modules/
.npm/
.yarn/
.pnpm-store/

# Runtime databases outside the canonical data/ directory
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# Logs, captures and large generated binary formats
*.log
*.bssraw
*.parquet
*.parquet.zst
*.feather
*.arrow
*.orc
*.avro
*.pcap
*.pcapng
*.zst
*.gz
*.bz2
